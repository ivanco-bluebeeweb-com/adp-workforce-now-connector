    }
  },
  "secrets": [
    {
      "name": "adp_connections",
      "description": "JSON array of saved ADP Workforce Now connections (client_id/secret, cert/key, tokens).",
      "required": false,
      "write_mode": "extension",
      "max_bytes": 65536,
      "scope": "user",
      "rotation_hint_days": 365
    }
  ],
  "panels": [
